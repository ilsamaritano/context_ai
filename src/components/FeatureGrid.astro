---
import Icon from './Icon.astro';
import type { IconName } from '../data/services';

interface Props {
  items: { icon?: IconName; title: string; text: string }[];
  columns?: 2 | 3;
}
const { items, columns = 3 } = Astro.props;
---

<ul role="list" class:list={['features', `features--${columns}`]}>
  {
    items.map((item) => (
      <li class="feature">
        {item.icon && (
          <span class="feature__icon">
            <Icon name={item.icon} size={22} />
          </span>
        )}
        <h3 class="feature__title">{item.title}</h3>
        <p class="feature__text">{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .feature {
    padding: var(--space-6);
    background: var(--bg);
  }
  :global(.section--surface) .feature {
    background: var(--surface);
  }
  .feature__icon {
    display: inline-flex;
    color: var(--accent);
    margin-bottom: var(--space-5);
  }
  .feature__title {
    font-size: var(--fs-md);
    font-weight: 560;
    letter-spacing: -0.012em;
    margin-bottom: var(--space-2);
  }
  .feature__text {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  /* Last item stretches to fill incomplete rows, avoiding empty cells. */
  @media (min-width: 700px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .features--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .features--3 .feature:last-child:nth-child(odd) {
      grid-column: auto;
    }
    .features--3 .feature:last-child:nth-child(3n + 2) {
      grid-column: span 2;
    }
    .features--3 .feature:last-child:nth-child(3n + 1) {
      grid-column: span 3;
    }
  }
</style>
