---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { services } from '../data/services';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.description,
      provider: { '@type': 'Organization', name: 'ContextAI' },
      areaServed: 'IT',
    },
  })),
};
---

<BaseLayout
  title="Servizi AI per le aziende: infrastruttura, modelli privati, RAG, automazione"
  description="Infrastruttura AI on-premise e cloud, modelli AI privati, soluzioni RAG e automazione dei processi aziendali. Scoprite i servizi di ContextAI per l’AI enterprise."
  jsonLd={jsonLd}
>
  <PageHero
    label="Servizi"
    title="Quattro competenze, un unico sistema"
    lead="Progettiamo l’AI come un sistema completo: infrastruttura, modelli, conoscenza aziendale e automazione. Potete partire da un singolo servizio e crescere sulla stessa base."
  >
    <nav class="toc" aria-label="Indice dei servizi">
      <ul role="list">
        {
          services.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHero>

  <div class="container">
    {
      services.map((s, i) => (
        <section class="svc" id={s.id} aria-labelledby={`${s.id}-title`}>
          <div class="svc__intro">
            <p class="eyebrow">
              <span class="svc__index">{String(i + 1).padStart(2, '0')}</span>
              Servizio
            </p>
            <div class="svc__heading">
              <span class="svc__icon">
                <Icon name={s.icon} size={26} />
              </span>
              <h2 id={`${s.id}-title`}>{s.title}</h2>
            </div>
            <p class="svc__desc">{s.description}</p>
          </div>

          <div class="svc__details">
            <div class="svc__block">
              <h3>Casi d’uso tipici</h3>
              <ul role="list" class="svc__list">
                {s.useCases.map((u) => (
                  <li>{u}</li>
                ))}
              </ul>
            </div>
            <div class="svc__block svc__block--benefits">
              <h3>Benefici</h3>
              <ul role="list" class="svc__list svc__list--check">
                {s.benefits.map((b) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <CtaBlock
    title="Non sapete da quale servizio partire?"
    text="È normale. Nella prima conversazione analizziamo il vostro contesto e vi indichiamo il punto di partenza con il miglior rapporto tra valore e complessità."
    secondary={null}
  />
</BaseLayout>

<style>
  .toc {
    margin-top: var(--space-7);
  }
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 480;
    transition: border-color 0.2s var(--ease);
  }
  .toc a:hover {
    border-color: var(--ink);
  }
  .toc span {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
  }

  .svc {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--section-y);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 68px;
  }
  .svc:last-child {
    border-bottom: 0;
  }
  .svc__index {
    color: var(--accent);
  }
  .svc__heading {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: var(--space-5) 0;
  }
  .svc__heading h2 {
    font-size: var(--fs-2xl);
  }
  .svc__icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .svc__desc {
    font-size: var(--fs-md);
    color: var(--ink-2);
    max-width: 56ch;
  }
  .svc__details {
    display: grid;
    gap: var(--space-4);
  }
  .svc__block {
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .svc__block h3 {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 450;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .svc__list li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }
  .svc__list li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .svc__list--check li {
    display: flex;
    gap: var(--space-3);
    color: var(--ink);
  }
  .svc__list--check :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent);
  }
  .svc__block--benefits {
    background: var(--surface-2);
    border-color: transparent;
  }
  .svc__block--benefits .svc__list li {
    border-color: var(--line-strong);
  }

  @media (min-width: 1024px) {
    .svc {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
      align-items: start;
    }
    .svc__intro {
      position: sticky;
      top: 110px;
    }
  }
  @media (min-width: 700px) {
    .svc__details {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
