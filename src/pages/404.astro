---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Pagina non trovata" description="La pagina richiesta non esiste." noindex>
  <PageHero label="Errore 404" title="Pagina non trovata" lead="L’indirizzo potrebbe essere cambiato o non essere più disponibile.">
    <p class="actions">
      <a class="btn btn--primary" href={url()}>Torna alla home <Icon name="arrow" size={16} /></a>
      <a class="btn btn--secondary" href={url('contatti/')}>Contattaci</a>
    </p>
  </PageHero>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
</style>
